# Copy to .env and adjust. Every value can also be passed as an environment
# variable; the prefix is RAG_ (see src/ragllmops/config.py).

# --- LLM provider -------------------------------------------------------
# extractive | openai | ollama
RAG_LLM_PROVIDER=extractive
RAG_LLM_MODEL=local-extractive-v1
# For provider=openai use https://api.openai.com/v1 ; for ollama use http://localhost:11434/v1
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=

# --- Embeddings ---------------------------------------------------------
# hashing (dependency-free, deterministic) | sentence-transformer
RAG_EMBEDDER_BACKEND=hashing
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIM=384

# --- Vector store -------------------------------------------------------
# qdrant | memory
RAG_VECTOR_STORE=qdrant
RAG_QDRANT_URL=http://localhost:6333
RAG_QDRANT_COLLECTION=ragllmops_chunks

# --- Retrieval (tuned against the golden set) --------------------------
# k=1: precision 0.93 / recall 0.87   k=2: 0.68 / 0.95   k=3: 0.52 / 0.95
RAG_RETRIEVAL_TOP_K=2
RAG_RETRIEVAL_CANDIDATES=20
RAG_RETRIEVAL_DENSE_WEIGHT=0.35
RAG_RETRIEVAL_SPARSE_WEIGHT=0.65
RAG_RERANK_ENABLED=true
RAG_MAX_CONTEXT_CHARS=6000

# --- Model registry -----------------------------------------------------
# mlflow | local
RAG_REGISTRY_BACKEND=local
RAG_MLFLOW_TRACKING_URI=http://localhost:5000
# Where the tracking server keeps the registered bundles. Leave it empty
# when the server is remote: the server then decides (and serves) the
# artifact location, which is the only thing a remote client can use.
RAG_MLFLOW_ARTIFACT_ROOT=./mlruns
RAG_REGISTRY_PATH=data/registry/registry.json
RAG_REGISTRY_NAME=ragllmops-bundle
RAG_CHAMPION_ALIAS=champion
RAG_CHALLENGER_ALIAS=challenger

# --- Request log --------------------------------------------------------
# sqlite | postgres
RAG_LOG_STORE_BACKEND=sqlite
RAG_SQLITE_PATH=data/logs/requests.db
RAG_POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag

# --- Feature store ------------------------------------------------------
# local | feast
RAG_FEATURE_BACKEND=local
RAG_FEAST_REPO=data/features/feature_repo
RAG_FEATURES_ONLINE_PATH=data/features/online_store.json

# --- Serving ------------------------------------------------------------
RAG_CANARY_TRAFFIC_PCT=0
# Requests per side before the canary comparison will draw a conclusion.
RAG_CANARY_MIN_SAMPLES=30
RAG_WATCHER_INTERVAL_SECONDS=15

# --- The learning loop --------------------------------------------------
# Where the trained ranker artifacts are stored (content-addressed).
RAG_MODELS_DIR=data/models

# --- Gates & monitoring -------------------------------------------------
RAG_EVAL_GATE_MIN_FAITHFULNESS=0.5
RAG_EVAL_GATE_MIN_CONTEXT_RECALL=0.6
RAG_EVAL_GATE_MIN_KEY_TERM_COVERAGE=0.5
# Only applies when the LLM judge actually returns verdicts (`evaluate --judge`).
RAG_EVAL_GATE_MIN_JUDGE_GROUNDED_RATE=0.5
RAG_DRIFT_PSI_THRESHOLD=0.2
RAG_DRIFT_MIN_SAMPLES=50
